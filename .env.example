# URL del endpoint externo (Cloudflare Worker, Netlify Function, etc.) que
# recibe el POST del formulario de contacto y envía el correo (p.ej. vía Resend).
# La API key de Resend NUNCA va aquí — vive solo en ese servicio externo.
VITE_CONTACT_ENDPOINT=

# URL del endpoint externo que recibe el POST del formulario de newsletter
# del footer ({ email, website }). Mismo patrón que VITE_CONTACT_ENDPOINT.
VITE_NEWSLETTER_ENDPOINT=

# Postgres. Opcional en build estático: sin esta variable, server/db.ts
# degrada a null y el build/prerender sigue funcionando igual.
DATABASE_URL=

# Usados solo por scripts/seed-admin.mjs para crear el primer usuario admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Secreto compartido con functions/contact-worker (su propio WORKER_SECRET,
# via `wrangler secret put`) para autorizar POST /api/public/request.
# server/publicRoutes.ts falla al arrancar si falta. Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKER_SECRET=
